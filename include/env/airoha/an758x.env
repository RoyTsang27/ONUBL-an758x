/* Shared serial and network recovery entry points for Airoha boards. */
#ifdef CONFIG_CMD_HTTPD
/* Privileged HTTP recovery requires an explicit serial-console command: httpd dhcp full. */
boot_recovery=httpd dhcp safe
boot_recovery_auto=httpd dhcp safe
httpd_ipaddr=192.168.0.1
httpd_netmask=255.255.255.0
#endif
ipaddr=192.168.0.1
netmask=255.255.255.0
serverip=192.168.0.254
stdin=serial
stdout=serial
stderr=serial
